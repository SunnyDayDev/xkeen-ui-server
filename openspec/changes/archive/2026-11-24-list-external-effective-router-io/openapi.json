{
  "openapi": "3.1.0",
  "info": {
    "title": "Effective router I/O",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/routers/io": {
      "get": {
        "security": [
          {
            "bearer": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "routerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Effective inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "inbounds",
                    "outbounds"
                  ],
                  "properties": {
                    "inbounds": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Member"
                      }
                    },
                    "outbounds": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Member"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authorization required"
          },
          "404": {
            "description": "Unavailable scope"
          },
          "405": {
            "description": "Method not allowed"
          },
          "409": {
            "description": "Snapshot changed"
          },
          "422": {
            "description": "Inventory unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Member": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "origin": {
            "enum": [
              "shared",
              "local"
            ]
          }
        }
      }
    }
  }
}
