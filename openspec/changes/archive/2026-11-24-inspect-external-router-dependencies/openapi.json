{
  "openapi": "3.1.0",
  "info": {
    "title": "XKeen external router dependencies",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://console.example.net"
    }
  ],
  "security": [
    {},
    {
      "externalBearer": []
    }
  ],
  "paths": {
    "/api/v1/routers/dependencies": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "routerId",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete dependency projection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "routerId": {
                      "type": "string"
                    },
                    "templateId": {
                      "type": "string"
                    },
                    "acceptedVersion": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "activeGeneration": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "draftGeneration": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "ready": {
                      "type": "boolean"
                    },
                    "references": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ruleId": {
                            "type": "string"
                          },
                          "elementId": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "path": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "targets": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "partIndex": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "ruleId",
                          "kind",
                          "path",
                          "status",
                          "targets",
                          "partIndex"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "routerId",
                    "templateId",
                    "acceptedVersion",
                    "activeGeneration",
                    "draftGeneration",
                    "ready",
                    "references"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "Structural analysis failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "const": "analysis_unavailable"
                    },
                    "issues": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "position": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "code",
                          "position"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "code",
                    "issues"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Unavailable router or disabled API",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "Conflicting router snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Storage failure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "externalBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required when F20 enables protection"
      }
    }
  }
}
