{
  "openapi": "3.1.0",
  "info": {
    "title": "XKeen external router rule state",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://console.example.net"
    }
  ],
  "security": [
    {},
    {
      "externalBearer": []
    }
  ],
  "paths": {
    "/api/v1/routers/rules/state": {
      "parameters": [
        {
          "in": "query",
          "name": "routerId",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "in": "query",
          "name": "elementId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "readRuleState",
        "responses": {
          "200": {
            "$ref": "#/components/responses/RuleState"
          },
          "400": {
            "$ref": "#/components/responses/HTTP400"
          },
          "401": {
            "$ref": "#/components/responses/HTTP401"
          },
          "404": {
            "$ref": "#/components/responses/HTTP404"
          },
          "409": {
            "$ref": "#/components/responses/HTTP409"
          },
          "405": {
            "$ref": "#/components/responses/HTTP405"
          },
          "503": {
            "$ref": "#/components/responses/HTTP503"
          }
        }
      },
      "patch": {
        "operationId": "setRuleDisabled",
        "parameters": [
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\"[0-9a-f]{64}\"$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "disabled"
                ],
                "properties": {
                  "disabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/RuleState"
          },
          "400": {
            "$ref": "#/components/responses/HTTP400"
          },
          "401": {
            "$ref": "#/components/responses/HTTP401"
          },
          "404": {
            "$ref": "#/components/responses/HTTP404"
          },
          "409": {
            "$ref": "#/components/responses/HTTP409"
          },
          "405": {
            "$ref": "#/components/responses/HTTP405"
          },
          "503": {
            "$ref": "#/components/responses/HTTP503"
          },
          "412": {
            "$ref": "#/components/responses/HTTP412"
          },
          "413": {
            "$ref": "#/components/responses/HTTP413"
          },
          "415": {
            "$ref": "#/components/responses/HTTP415"
          },
          "422": {
            "$ref": "#/components/responses/HTTP422"
          },
          "428": {
            "$ref": "#/components/responses/HTTP428"
          },
          "403": {
            "$ref": "#/components/responses/HTTP403"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "externalBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required when F20 enables protection"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "RuleState": {
        "type": "object",
        "required": [
          "routerId",
          "templateId",
          "acceptedVersion",
          "activeGeneration",
          "draftGeneration",
          "elementId",
          "origin",
          "position",
          "personalDisabled",
          "disabled",
          "excluded"
        ],
        "properties": {
          "routerId": {
            "type": "string",
            "minLength": 1
          },
          "templateId": {
            "type": "string",
            "minLength": 1
          },
          "acceptedVersion": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "activeGeneration": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "draftGeneration": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "elementId": {
            "type": "string",
            "format": "uuid"
          },
          "origin": {
            "enum": [
              "shared",
              "local"
            ]
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "personalDisabled": {
            "type": "boolean"
          },
          "disabled": {
            "type": "boolean"
          },
          "excluded": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "HTTP400": {
        "description": "Invalid query or body",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HTTP401": {
        "description": "Protected API requires current credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HTTP404": {
        "description": "Disabled API or unavailable resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HTTP409": {
        "description": "The selected template, order or effective dependency structure cannot support this change.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HTTP405": {
        "description": "Method not allowed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HTTP503": {
        "description": "Service unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HTTP412": {
        "description": "Conditional basis is stale",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HTTP413": {
        "description": "Request body exceeds 8 MiB",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HTTP415": {
        "description": "Unsupported media type",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HTTP422": {
        "description": "Invalid literal JSON source",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HTTP428": {
        "description": "If-Match required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HTTP403": {
        "description": "Supplied browser Origin does not match the HTTPS origin",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RuleState": {
        "description": "Current personal and effective rule state in complete order",
        "headers": {
          "ETag": {
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\"[0-9a-f]{64}\"$"
            }
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "example": "no-store, no-transform"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RuleState"
            }
          }
        }
      }
    }
  }
}
