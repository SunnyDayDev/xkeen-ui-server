{
  "openapi": "3.1.0",
  "info": {
    "title": "External router profile switch",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://console.example.net"
    }
  ],
  "security": [
    {},
    {
      "externalBearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "externalBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/api/v1/routers/profile-switch": {
      "parameters": [
        {
          "name": "routerId",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "templateId",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "get": {
        "operationId": "readExternalProfileSwitch",
        "responses": {
          "200": {
            "description": "Current assignment and safe fields",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "routerId": {
                      "type": "string"
                    },
                    "activeTemplateId": {
                      "type": "string"
                    },
                    "targetTemplateId": {
                      "type": "string"
                    },
                    "alreadyActive": {
                      "type": "boolean"
                    },
                    "restoring": {
                      "type": "boolean"
                    },
                    "desiredRevision": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "elementId": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "required": {
                            "type": "boolean"
                          },
                          "hasPersonalValue": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "elementId",
                          "name",
                          "type",
                          "required",
                          "hasPersonalValue"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "routerId",
                    "activeTemplateId",
                    "targetTemplateId",
                    "alreadyActive",
                    "restoring",
                    "desiredRevision",
                    "fields"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Disabled, hidden or missing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "Candidate rejected or unready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "previewOrConfirmExternalProfileSwitch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "const": "preview"
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "elementId": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "name": {
                              "type": "string"
                            },
                            "source": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "description": "Exact JSON source text, or null to inherit"
                            }
                          },
                          "required": [
                            "elementId",
                            "name",
                            "source"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "action",
                      "values"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "const": "confirm"
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "elementId": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "name": {
                              "type": "string"
                            },
                            "source": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "description": "Exact JSON source text, or null to inherit"
                            }
                          },
                          "required": [
                            "elementId",
                            "name",
                            "source"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "receipt": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "action",
                      "values",
                      "receipt"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preview or committed desired state",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "routerId": {
                          "type": "string"
                        },
                        "activeTemplateId": {
                          "type": "string"
                        },
                        "targetTemplateId": {
                          "type": "string"
                        },
                        "restoring": {
                          "type": "boolean"
                        },
                        "changed": {
                          "type": "boolean"
                        },
                        "files": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "kind": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "name",
                              "kind"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "receipt": {
                          "type": "string"
                        },
                        "order": {
                          "type": "object",
                          "required": [
                            "state",
                            "added",
                            "removed"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "state": {
                              "enum": [
                                "inherit",
                                "retained",
                                "reconciled"
                              ]
                            },
                            "added": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "removed": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        }
                      },
                      "required": [
                        "routerId",
                        "activeTemplateId",
                        "targetTemplateId",
                        "restoring",
                        "changed",
                        "files",
                        "receipt",
                        "order"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "routerId": {
                          "type": "string"
                        },
                        "activeTemplateId": {
                          "type": "string"
                        },
                        "changed": {
                          "type": "boolean"
                        },
                        "desiredRevision": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$"
                        }
                      },
                      "required": [
                        "routerId",
                        "activeTemplateId",
                        "changed",
                        "desiredRevision"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
