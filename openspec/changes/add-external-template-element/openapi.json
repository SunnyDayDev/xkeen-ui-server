{
  "openapi": "3.1.0",
  "info": {
    "title": "XKeen external template element addition",
    "version": "1"
  },
  "paths": {
    "/api/v1/templates/item/elements": {
      "post": {
        "operationId": "addTemplateElement",
        "description": "Conditionally adds one element to a saved draft. The body limit is 8388608 bytes.",
        "security": [
          {
            "externalBearer": []
          },
          {}
        ],
        "parameters": [
          {
            "in": "query",
            "name": "templateId",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\"[0-9a-f]{64}\"$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "section",
                  "elementId",
                  "source"
                ],
                "properties": {
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "elementId": {
                    "$ref": "../2026-11-24-define-external-management-api/openapi.json#/components/schemas/ElementID"
                  },
                  "source": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Element added to the draft",
            "headers": {
              "ETag": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              },
              "Content-Location": {
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../2026-11-24-define-external-management-api/openapi.json#/components/schemas/TemplateDraft"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, target or tag"
          },
          "401": {
            "description": "Missing, invalid or revoked authorization"
          },
          "403": {
            "description": "Request origin refused"
          },
          "404": {
            "description": "Template missing or external API disabled"
          },
          "409": {
            "description": "UUID already in use or the singleton section is occupied"
          },
          "412": {
            "description": "Template changed"
          },
          "413": {
            "description": "Request body exceeds 8388608 bytes"
          },
          "415": {
            "description": "Expected application/json"
          },
          "422": {
            "description": "Invalid element JSON"
          },
          "428": {
            "description": "If-Match required"
          },
          "503": {
            "description": "Storage unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "externalBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
